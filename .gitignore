# deps
node_modules/
.venv/
venv/
__pycache__/
*.pyc

# builds
dist/
build/
*.egg-info/
.next/
.cache/
.tsbuildinfo

# env & secrets — never commit real env files
.env
.env.*
!.env.example
*.pem
*.key

# os / editor
.DS_Store
*.log
.idea/
.vscode/

# ai harness local state (remove this block if the project wants .planning committed)
.claude/settings.local.json
.planning/
.impeccable/

# local tool state
.wrangler/

# blender auto-backups — never commit (P6 sanitizer; 27MB of *.blend1 already in
# history is flagged in docs/p6/sanitizer.md)
*.blend1

# heavy source-reference media — regenerable via evals/reference/source/capture-scripts
evals/reference/source/desktop/
evals/reference/source/mobile/
evals/reference/source/videos/
evals/reference/source/interactions/

# third-party raw asset archives — provenance rule: ship processed GLB only
research/assets-candidates/

# regenerated every eval round (pnpm eval:capture)
evals/reference/ours/

# uncompressed draft GLBs — keep only gltfpack .ktx2.glb outputs
research/asset-qa/*-draft.glb
!research/asset-qa/*.ktx2.glb

# blind-council seat composites — regenerable from pairs.ts + sealed seed (answers/manifest/ballots stay committed)
evals/judge/pack/seat-*/
