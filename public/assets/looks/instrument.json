  "x_sectionLightKeyframes": {
    "comment": "Per-section lighting choreography (env rotation + intensity + exposure), driven off the clock scalar via stage.setEnvRotation/setEnvIntensity/toneMappingExposure. Linear interp between section centers; full 360 revolution over the page so the outro restart loops seamlessly. P2 sections own the wiring.",
    "keyframes": [
      {
        "section": "Intro",
        "envRotationDeg": 0,
        "envIntensity": 1.0,
        "exposure": 1.05,
        "note": "hero pose — key upper-left, rim behind right"
      },
      {
        "section": "Timeless",
        "envRotationDeg": 15,
        "envIntensity": 1.0,
        "exposure": 1.05
      },
      {
        "section": "VerticalText",
        "envRotationDeg": 35,
        "envIntensity": 0.95,
        "exposure": 1.05,
        "note": "light quiets under the word stack"
      },
      {
        "section": "Disassembly",
        "envRotationDeg": 70,
        "envIntensity": 1.1,
        "exposure": 1.1,
        "note": "key sweeps across the exploded parts, hardest read of the page"
      },
      {
        "section": "Mechanism",
        "envRotationDeg": 110,
        "envIntensity": 1.05,
        "exposure": 1.05,
        "bgStage": "#101216",
        "note": "dark beat — bgStage darkens the DOM ground so live metal reads against ink (LOOKBIBLE 1.4 live-parity law)"
      },
      {
        "section": "Movement",
        "envRotationDeg": 140,
        "envIntensity": 0.95,
        "exposure": 1.05
      },
      {
        "section": "Curves",
        "envRotationDeg": 170,
        "envIntensity": 1.0,
        "exposure": 1.05,
        "note": "streak strip grazes the chamfer — the signature spec crawl"
      },
      {
        "section": "MovementWatchRight",
        "envRotationDeg": 200,
        "envIntensity": 1.0,
        "exposure": 1.05
      },
      {
        "section": "Hands",
        "envRotationDeg": 225,
        "envIntensity": 0.9,
        "exposure": 1.05
      },
      {
        "section": "Straps",
        "envRotationDeg": 250,
        "envIntensity": 1.05,
        "exposure": 1.05,
        "note": "band macro — fill side faces camera, fluoroelastomer stays matte"
      },
      {
        "section": "Images",
        "envRotationDeg": 250,
        "envIntensity": 1.05,
        "exposure": 1.05,
        "note": "DOM section — hold"
      },
      {
        "section": "Nocturne",
        "envRotationDeg": 290,
        "envIntensity": 0.35,
        "exposure": 0.95,
        "bloomStrength": 0.85,
        "bgStage": "#0A0B0D",
        "note": "GRAFT from dusk (council law): continuum dip to 0.35 — not blackout — with hot dial bloom 0.85; vignette flag on. The deep 0.045 blackout survives only as the AOD match-cut beat INSIDE the section (porcelain graft), restored to 0.35 by the section's own exit"
      },
      {
        "section": "Colors",
        "envRotationDeg": 330,
        "envIntensity": 1.0,
        "exposure": 1.05,
        "note": "recovery ramp out of Nocturne"
      },
      {
        "section": "Parts",
        "envRotationDeg": 350,
        "envIntensity": 1.0,
        "exposure": 1.05
      },
      {
        "section": "Footer",
        "envRotationDeg": 360,
        "envIntensity": 1.0,
        "exposure": 1.05,
        "note": "full revolution — restart loop lands on the Intro pose"
      }
    ]
